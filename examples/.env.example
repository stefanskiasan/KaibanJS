# KaibanJS Orchestration Examples - Environment Variables
# Copy this file to .env and add your API keys

# OpenAI API Key (Required for most examples)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Anthropic API Key (for Claude models)
# Get your key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Google API Key (for Gemini models)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Mistral API Key
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: XAI API Key (for Grok models)
# Get your key from: https://x.ai/api
XAI_API_KEY=your-xai-api-key-here

# Optional: Deep Seek API Key
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Custom API Base URLs (for self-hosted or proxy endpoints)
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# Optional: Disable telemetry
# KAIBAN_TELEMETRY_OPT_OUT=true

# Model Recommendations for Examples:
# - Basic examples: gpt-4o-mini (cost-effective)
# - Complex orchestration: gpt-4o or gpt-4-turbo
# - Creative tasks: gpt-4o with higher temperature
# - Production: gpt-4o with low temperature (0.1-0.3)